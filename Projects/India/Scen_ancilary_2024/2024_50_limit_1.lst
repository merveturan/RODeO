395575  *===============================================================================
395576  * DEPRECIATION SCHEDULES
395577  *===============================================================================
395578   
395579  parameter depreciation_schedule(years)  "Depreciation Schedule over year"
395580  /
395589  /;
395590   
395591  parameter  bonus_depreciation_schedule(years), NoYears;
395592  * For accelerated depreciation, bonus depreciation can vary from 50% to up to 100%. In future, it will go to 0%
395593  bonus_depreciation_schedule(years)$(ord(years)=1) = bonus_depreciation + (1-bonus_depreciation)*depreciation_schedule(years);
395594  bonus_depreciation_schedule(years)$(ord(years)>1) = (1-bonus_depreciation)*depreciation_schedule(years);
395595  * The basis for depreciation is directly calculated and is dependent of the Investment Tax Credit
395596  deprec_base_reduction = 1 - 0.5*ITC   ;
395597  * A scalar that takes the number of years considered in the optimization
395598  NoYears = card(years);
395599  * USA inflation vector is 1.9%
395600  inflation_vec(years) = (1 + 0.019)**(ord(years)-1);
395601  wacc =  (1 - equity)*(1 - debt_interest)*ror + equity*roe ;
395602  to_NPV(years) = (wacc + 1)**(ord(years)) ;
395603  *===============================================================================
395604   
395605  H2_price(interval,devices)              = H2_price2(interval,devices);
395606  *H2_consumed(interval,devices)           = H2_consumed2(interval,devices);
395607  H2_consumed(interval,devices)           = 0;
395608  renewable_signal(interval,devices_ren)  = renewable_signal2(interval,devices_ren);
395609  Max_input_cap(interval,devices)         = Max_input_cap2(interval,devices) * share_energy;
395610  Max_output_cap(interval,devices)        = Max_output_cap2(interval,devices) * share_energy;
395611   
395612  Parameter   H2_price_init(interval,devices) ;
395613  H2_price_init(interval,devices) =  H2_price(interval,devices) ;
