53152           min_input_on_intervals  'minimum number of intervals the input side of the facility can be on at a time' /0/
53153   
53154           current_interval        'current interval for real-time optimization runs'                              /-1/
53155           next_interval           'next interval for real-time optimization runs'                                 /1/
53156           current_storage_lvl     'current storage level for real-time optimization runs (0-100%, 0-1)'           /0.5/
53157           current_monthly_max     'current monthly maximum demand for real-time optimization runs (0-100%, 0-1)'  /0.8/
53158           max_interval            'maximum interval for real-time optimization runs'                              /Inf/
53159           read_MPC_file           'read controller values from excel file'                                        /0/
53160           ramp_penalty            'set ramp penalty for input and output devices'                                 /0/
53161           allow_import            'Allows or restricts imports 0=no imports, 1=allows imports'                    /1/
53162           allow_sales             'Restricts sales if = 0'                                                        /1/
53163           nominal_penalty         'Used to add penalty price that is not considered in the results'               /0.000001/
53164           price_cap               'Set price cap for input prices'                                                /10000000/
53165   
53166           H2_EneDens              "Energy density of hydrogen (MJ/kg)"                                            /120/
53167           EER                     "Energy economy ratio relative to alternative fuel"                             /4.2/
53168           Grid_CarbInt            "Carbon intensity of electricity from the grid (gCO2e/MJ)"                      /81.49/
53169           CI_base_line            "Base line carbon intensity for the displaced fuel and current year (gCO2e/MJ)" /91.81/
53170           LCFS_price              "Low Carbon Fuel Standard (LCFS) credit prices ($ per credit)"                  /0/
53171   
53172           val_from_batch          "Set values from GUI input or batch file (yes=1, no=2) (works with 1 device & 1 renewable)"  /2/
53173           ITC                     "Business Energy Investment Tax Credit (ITC) (fraction between 0 and 1)"        /0/
53174           wacc                    "Weighted average capital cost (wacc) [-]"                                      /0.07/
53175           cftr                    "Combined federal and local taxes     [-]"                                      /0/
53176           bonus_depreciation      "Bonus depreciation fraction [-]"                                               /0.5/
53177           equity                  "Percent equity              [-]"                                               /0.419/
