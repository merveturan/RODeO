395615  if (run_retail=0,
395616           elec_purchase_price(interval) = elec_purchase_price_interim(interval);
395617           elec_sale_price(interval)     = elec_sale_price_interim(interval);
395618           elec_purchase_price_RT(interval) = elec_purchase_price_RT_interim(interval);
395619           elec_sale_price_RT(interval)     = elec_sale_price_RT_interim(interval);
395620           regup_price(interval)         = regup_price_interim(interval);
395621           regdn_price(interval)         = regdn_price_interim(interval);
395622           spinres_price(interval)       = spinres_price_interim(interval);
395623           nonspinres_price(interval)    = nonspinres_price_interim(interval);
395624           meter_mnth_chg(interval)      = meter_mnth_chg(interval) * 0;
395625           Fixed_dem(months)             = Fixed_dem(months) * 0;
395626           Timed_dem(timed_dem_period)   = Timed_dem(timed_dem_period) * 0;
395627           TOU_energy_prices(TOU_energy_period) = TOU_energy_prices(TOU_energy_period) * 0;
395628  elseif run_retail=2,
395629           elec_sale_price(interval)     = elec_sale_price_interim(interval);
395630           elec_sale_price_RT(interval)     = elec_sale_price_RT_interim(interval);
395631           regup_price(interval)         = regup_price_interim(interval);
395632           regdn_price(interval)         = regdn_price_interim(interval);
395633           spinres_price(interval)       = spinres_price_interim(interval);
395634           nonspinres_price(interval)    = nonspinres_price_interim(interval);
395635  elseif (run_retail=1 and 0=1),
395636           REC_price                     = 0;
395637           elec_sale_price(interval)     = elec_sale_price_interim(interval);
395638           elec_sale_price_RT(interval)     = elec_sale_price_RT_interim(interval);
395639  elseif run_retail=1,
395640           REC_price                     = 0;
395641           elec_sale_price(interval)     = elec_sale_price_interim(interval);
395642           elec_sale_price_RT(interval)     = elec_sale_price_RT_interim(interval);
395643  );
