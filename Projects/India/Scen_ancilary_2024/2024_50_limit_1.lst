395679  * Remove all GDX files after loading data
395680  *$call rm -rf %indir%%ds%*.gdx
395681  *$call rm -rf %indir%%ds%H2_consumption%ds%*.gdx
395682  *$call rm -rf %indir%%ds%Input_cap%ds%*.gdx
395683  *$call rm -rf %indir%%ds%Output_cap%ds%*.gdx
395684   
395685  *reseed the random number generator
395686  execseed = 1 + gmillisec(jnow);
395687  *generate an imperfect price forecast
395688  *elec_price_forecast(interval) = elec_price(interval) * uniform(0.95, 1.05);
395689   
395690  * Limit purchase and sale prices to the price_cap value
395691  elec_purchase_price(interval) = 1/1*(price_cap+elec_purchase_price(interval)-ABS(elec_purchase_price(interval)-price_cap))/2;
395692  elec_purchase_price_forecast(interval) = elec_purchase_price(interval)+nominal_penalty;
395693   
395694  elec_sale_price(interval) = 1/1*(price_cap+elec_sale_price(interval)-ABS(elec_sale_price(interval)-price_cap))/2;
395695  elec_sale_price_forecast(interval) = elec_sale_price(interval);
395696   
395697  * Scale renewable signal to desired installed capacity level
395698  Renewable_power(interval,devices_ren) = renewable_signal(interval,devices_ren) * Renewable_MW(devices_ren);
395699   
395700  * Adjust the lifetime if it is equal to zero and zero the cost components (i.e., raising to the power of 0 throws an error)
395701  loop(devices,
395702           if (output_lifetime(devices)=0,     output_lifetime(devices)=1;    output_cap_cost(devices)=0;    output_FOM_cost(devices)=0;    output_VOM_cost(devices)=0;    interest_rate(devices)=0.01;);
395703           if ( input_lifetime(devices)=0,     input_lifetime(devices)=1;     input_cap_cost(devices)=0;     input_FOM_cost(devices)=0;     input_VOM_cost(devices)=0;     interest_rate(devices)=0.01;   input_cap_alt_cost(devices)=0;  input_FOM_alt_cost(devices)=0;);
395704           if (H2stor_lifetime(devices)=0,     H2stor_lifetime(devices)=1;    H2stor_cap_cost(devices)=0;                                                                  H2stor_interest_rate(devices)=0.01;);
395705           if (H2comp_lifetime(devices)=0,     H2comp_lifetime(devices)=1;    H2comp_cap_cost(devices)=0;                                                                  H2comp_interest_rate(devices)=0.01;);
395706  );
395707  loop(devices_ren,
395708           if ( renew_lifetime(devices_ren)=0, renew_lifetime(devices_ren)=1; renew_cap_cost(devices_ren)=0; renew_FOM_cost(devices_ren)=0; renew_VOM_cost(devices_ren)=0; renew_interest_rate(devices_ren)=0.01;);
395709  );
395710   
395711  *check to make sure operating period length is not longer than the number of intervals in the input file
395712  if ( operating_period_length > card(interval), operating_period_length = card(interval) );
395713   
395714  *set values for allowable AS capacities
395715  loop(devices,
395716      if (energy_only(devices)=1,
395717           output_regup_limit_fraction(devices)      = 0;
395718           output_regdn_limit_fraction(devices)      = 0;
395719           output_spinres_limit_fraction(devices)    = 0;
395720           output_nonspinres_limit_fraction(devices) = 0;
395721   
395722           input_regup_limit_fraction(devices)       = 0;
395723           input_regdn_limit_fraction(devices)       = 0;
395724           input_spinres_limit_fraction(devices)     = 0;
395725           input_nonspinres_limit_fraction(devices)  = 0;
395726      elseif baseload_operation(devices)=1,
395727           output_regup_limit_fraction(devices)      = 1;
395728           output_regdn_limit_fraction(devices)      = 1;
395729           output_spinres_limit_fraction(devices)    = 1;
395730           output_nonspinres_limit_fraction(devices) = 1;
395731   
395732           input_regup_limit_fraction(devices)       = 0;
395733           input_regdn_limit_fraction(devices)       = 0;
395734           input_spinres_limit_fraction(devices)     = 0;
395735           input_nonspinres_limit_fraction(devices)  = 0;
395736      else
395737           output_regup_limit_fraction(devices)      = 1;
395738           output_regdn_limit_fraction(devices)      = 1;
395739           output_spinres_limit_fraction(devices)    = 1;
395740           output_nonspinres_limit_fraction(devices) = 1;
395741   
395742           input_regup_limit_fraction(devices)       = 1;
395743           input_regdn_limit_fraction(devices)       = 1;
395744           input_spinres_limit_fraction(devices)     = 1;
395745           input_nonspinres_limit_fraction(devices)  = 1;
395746      );
395747  );
395748   
395749  *scalars for rolling window implementation
395750  *note that the rolling window is the current operating period plus a look-ahead
395751  *period to give residual value to stored energy at the end of the current
395752  *operating period
