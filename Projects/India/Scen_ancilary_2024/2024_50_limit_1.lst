396045           system_power_eqn2(interval)             "sets the maximum system non-renewable input power level"
396046           one_active_device_eqn(interval,devices) equation to ensure that both generator and pump cannot be simultaneously active
396047           device_num_eqn                          limit the number of devices to a specified number
396048  ***         active_interval_devices_eqn             Find binary values for when device is operating
396049  ***         number_of_chargers_eqn                  Find number of chargers
396050  ***         Charger_calc_eqn(interval)              determine the number of chargers on for each interval
396051  ;
396052   
396053  * Adjusts the price of natural gas to the selected value "NG_price_adj"
396054  NG_price(interval) = NG_price(interval) * NG_price_adj;
396055   
396056  * Check to see if H2 will be exported for this analysis (i.e., H2 = 1 or 2)
396057  loop(devices,
396058      if (H2_use(devices) = 0,
396059           H2_consumed(interval,devices) = H2_consumed(interval,devices) * 0;
396060           H2_price(interval,devices)    = H2_price(interval,devices)*0;
396061      elseif H2_use(devices)=1,
396062           H2_price(interval,devices) = H2_price(interval,devices) * H2_price_adj(devices);
396063           if (CF_opt=0,
396064                   H2_consumed(interval,devices) = H2_consumed(interval,devices) * H2_consumed_adj(devices) * input_capacity_MW(devices) * input_efficiency(devices) / H2_LHV * 24 * interval_length;
396065           elseif CF_opt=1,
396066                   H2_consumed_adj(devices) = input_capacity_MW(devices) * input_efficiency(devices) / H2_LHV *24;
396067           );
396068      elseif H2_use(devices)=2,
396069      );
396070  );
396071   
396072  H2_CF_eqn(interval,devices)$( H2_sw and rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index and CF_opt=1)..
396073           H2_sold(interval,devices) =e= H2_consumed(interval,devices) * H2_consumed_adj(devices) * Hydrogen_fraction;
396074   
396075  H2_CF_eqn2$(H2_sw and CF_opt=1).. Hydrogen_fraction =l= 1;
396076  H2_CF_eqn3$(CF_opt=0).. Hydrogen_fraction =e= 1;
396077   
396078   
396079  *** Cost function: Elec sale price, elec purchase price, regup, regdown, spin, nonspin, NGout/in, unused VOM cost, startup cost, H2 price, VOM cost, demand charge (fixed and timed), meter cost, cap and FOM cost, etc.
396080   
396081  operating_profit_eqn..
396082   
396083                operating_profit =e=
396084   
396085                   - sum(devices_ren, equity * renew_cap_cost(devices_ren) * Renewable_MW(devices_ren))
396086                   - sum(devices, equity * input_cap_cost(devices)  * input_capacity_MW(devices) * active_devices(devices))
396087                   - sum(devices, equity * output_cap_cost(devices) * output_capacity_MW(devices) * active_devices(devices))
396088                   - sum(devices, equity * H2stor_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) * ( input_efficiency(devices) / H2_LHV )*storage_capacity_hours(devices))
396089                   - sum(devices, equity * H2comp_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) * ( input_efficiency(devices) / H2_LHV ))
396090                   - sum(devices, equity * input_cap_alt_cost(devices) * input_capacity_MW(devices) * (1-active_devices(devices)))
396091                   + sum(years,[yearly_taxes(years)
396092                   - debt_service
396093                   + inflation_vec(years)*yearly_operating_profit]/to_NPV(years))
396094  * Removed heuristic penalty: cycling is now governed by explicit constraints (cooldown_separation_eqn, total_cooldowns_eqn).
396095  *                - sum((interval,devices),100 * cooldown(interval,devices))
396096  ;
396097   
396098  depreciation(years)..
396099  amount_depreciated(years) =e= deprec_base_reduction*bonus_depreciation_schedule(years)*[sum(devices_ren, renew_cap_cost(devices_ren) * Renewable_MW(devices_ren))
396100                              + sum(devices, input_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) + input_cap_alt_cost(devices) * input_capacity_MW(devices) * (1-active_devices(devices)) + output_cap_cost(devices) * output_capacity_MW(devices) * active_devices(devices))]
396101                              + depreciation_schedule(years)*[sum(devices, H2stor_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) *( input_efficiency(devices) / H2_LHV )*storage_capacity_hours(devices))
396102                              + sum(devices, H2comp_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) *( input_efficiency(devices) / H2_LHV ))];
396103   
396104  yearly_operating_profit_eqn..
396105           yearly_operating_profit =e=
396106                  sum( (interval)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index ),
396107                          yearly_operating_profit_interval(interval))
396108                   - sum(months, Fixed_cap(months) * Fixed_dem(months))
396109                   - sum(months, cap_1(months) * Timed_dem("1"))
396110                   - sum(months, cap_2(months) * Timed_dem("2"))
396111                   - sum(months, cap_3(months) * Timed_dem("3"))
396112                   - sum(months, cap_4(months) * Timed_dem("4"))
396113                   - sum(months, cap_5(months) * Timed_dem("5"))
396114                   - sum(months, cap_6(months) * Timed_dem("6"))
396115                   - meter_mnth_chg("1") * 12
396116                   - sum(devices_ren,renew_FOM_cost(devices_ren) * Renewable_MW(devices_ren))
396117                   - sum(devices,input_FOM_cost(devices) * input_capacity_MW(devices) * active_devices(devices))
396118                   - sum(devices,input_FOM_alt_cost(devices) * input_capacity_MW(devices) * (1-active_devices(devices)))
396119                   - sum(devices,output_FOM_cost(devices)* output_capacity_MW(devices) * active_devices(devices))
396120                   + sum((months,TOU_energy_period),(NSCR(months)-TOU_energy_prices(TOU_energy_period)-NBC)*electricity_surplus(months,TOU_energy_period))*(0)
396121                   + sum((months,TOU_energy_period),(TOU_energy_prices(TOU_energy_period))*[sum(interval$(month_interval(months,interval) and elec_TOU_bins(TOU_energy_period,interval) and rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index),
396122                     interval_length*(sum(devices_ren,renewable_power_MW_sold(interval,devices_ren))+sum(devices,output_power_MW(interval,devices))-Import_elec_profile(interval)))])*(0)
396123                   - sum(devices, CF_adjust(devices))*CF_penalty
396124                   ;
396125   
396126  yearly_operating_profit_interval_eqn(interval)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
396127           yearly_operating_profit_interval(interval) =e=
396128                  (elec_sale_price_forecast(interval)*(sum(devices,output_power_MW_ren_sold(interval,devices)+output_power_MW_non_ren_sold(interval,devices))
396129                  +sum(devices_ren,renewable_power_MW_sold(interval,devices_ren))) * interval_length)*(1-0)
396130                   + REC_price * (sum(devices_ren,renewable_power_MW_sold(interval,devices_ren)) + sum(devices,output_power_MW_ren_sold(interval,devices))) * interval_length
396131                   - (elec_purchase_price_forecast(interval) * Import_elec_profile(interval) * interval_length)*(1-0)
396132                   + ( regup_price(interval) - reg_cost ) * ( sum(devices,output_regup_MW(interval,devices) + input_regup_MW(interval,devices)) ) * interval_length
396133                   + ( regdn_price(interval) - reg_cost ) * ( sum(devices,output_regdn_MW(interval,devices) + input_regdn_MW(interval,devices)) ) * interval_length
396134                   + spinres_price(interval) * ( sum(devices,output_spinres_MW(interval,devices) + input_spinres_MW(interval,devices)) ) * interval_length
396135                   + nonspinres_price(interval) * ( sum(devices,output_nonspinres_MW(interval,devices) + input_nonspinres_MW(interval,devices)) ) * interval_length
396136                   - sum(devices,output_heat_rate(devices) * NG_price(interval) * output_power_MW(interval,devices)) * interval_length
396137                   - sum(devices,input_heat_rate(devices) * NG_price(interval) * input_power_MW(interval,devices)) * interval_length
396138                   - VOM_cost * sum(devices,output_power_MW(interval,devices)) * interval_length
396139                   - sum(devices,output_startup_cost(devices) * output_capacity_MW(devices) * output_start(interval,devices))
396140                   - sum(devices,input_startup_cost(devices) * input_capacity_MW(devices) * input_start(interval,devices))
396141                   + sum(devices,H2_price(interval,devices) * H2_sold(interval,devices))
396142                   + sum(devices,(CI_base_line*EER - Grid_CarbInt/input_efficiency(devices))*LCFS_price*H2_EneDens*(power(10,-6)) * H2_sold(interval,devices))
396143                   + sum(devices,Grid_CarbInt*LCFS_price*H2_EneDens*(power(10,-6)) * H2_sold_ren(interval,devices))
396144                   - sum(devices_ren,renew_VOM_cost(devices_ren) * Renewable_power(interval,devices_ren))* interval_length
396145                   - sum(devices,input_VOM_cost(devices) * input_power_MW(interval,devices)) * interval_length
396146                   - sum(devices,output_VOM_cost(devices)* output_power_MW(interval,devices))* interval_length
396147                   - sum(devices,(input_ramp_pos(interval,devices)+input_ramp_neg(interval,devices))*ramp_penalty)
396148                   - sum(devices,(output_ramp_pos(interval,devices)+output_ramp_neg(interval,devices))*ramp_penalty)
396149                   + sum(devices, storage_level_MWh(interval,devices)) * Storage_penalty * (1-1)
396150  ;
396151   
396152  * Taxes include an ITC offset for renewables, input devices and output devices (change as necessary for specific technologies).
396153  taxes_lin1(years)..
396154                    - cftr*(yearly_operating_profit*inflation_vec(years) - amount_depreciated(years))
396155                    + reserved_taxes(years-1)
396156                    + ITC*deprec_base_reduction*[sum(devices_ren, renew_cap_cost(devices_ren) * Renewable_MW(devices_ren))
396157                    + sum(devices, input_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) + input_cap_alt_cost(devices) * input_capacity_MW(devices) * (1-active_devices(devices)) + output_cap_cost(devices) * output_capacity_MW(devices) * active_devices(devices))]$(ord(years)=1)
396158                    =l= big_Mtaxes*(1 - taxes_active(years)) ;
396159   
396160  taxes_lin2(years)..
396161                    - cftr*(yearly_operating_profit*inflation_vec(years) - amount_depreciated(years))
396162                    + reserved_taxes(years-1)
396163                    + ITC*deprec_base_reduction*[sum(devices_ren, renew_cap_cost(devices_ren) * Renewable_MW(devices_ren))
396164                    + sum(devices, input_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) + input_cap_alt_cost(devices) * input_capacity_MW(devices) * (1-active_devices(devices)) + output_cap_cost(devices) * output_capacity_MW(devices) * active_devices(devices))]$(ord(years)=1)
396165                    =g= -big_Mtaxes*taxes_active(years) ;
396166   
396167  taxes_lin3(years)..
396168                   yearly_taxes(years) - [- cftr*(yearly_operating_profit*inflation_vec(years) - amount_depreciated(years))
396169                    + reserved_taxes(years-1)
396170                    + ITC*deprec_base_reduction*[sum(devices_ren, renew_cap_cost(devices_ren) * Renewable_MW(devices_ren))
396171                    + sum(devices, input_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) + input_cap_alt_cost(devices) * input_capacity_MW(devices) * (1-active_devices(devices)) + output_cap_cost(devices) * output_capacity_MW(devices) * active_devices(devices))]$(ord(years)=1)]
396172                   =l= big_Mtaxes*(1 - taxes_active(years)) ;
396173   
396174  taxes_lin4(years)..
396175                   yearly_taxes(years) - [- cftr*(yearly_operating_profit*inflation_vec(years) - amount_depreciated(years))
396176                    + reserved_taxes(years-1)
396177                    + ITC*deprec_base_reduction*[sum(devices_ren, renew_cap_cost(devices_ren) * Renewable_MW(devices_ren))
396178                    + sum(devices, input_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) + input_cap_alt_cost(devices) * input_capacity_MW(devices) * (1-active_devices(devices)) + output_cap_cost(devices) * output_capacity_MW(devices) * active_devices(devices))]$(ord(years)=1)]
396179                   =g= -big_Mtaxes*(1 - taxes_active(years)) ;
396180   
396181  taxes_lin5(years)..
396182                   yearly_taxes(years) =g= - big_Mtaxes*taxes_active(years) ;
396183   
396184   
396185  reserved_taxes_eqn(years)..
396186  reserved_taxes(years)  =e= reserved_taxes(years-1) - yearly_taxes(years) - cftr*(yearly_operating_profit*inflation_vec(years) - amount_depreciated(years))
396187                           + ITC*deprec_base_reduction*[sum(devices_ren, renew_cap_cost(devices_ren) * Renewable_MW(devices_ren))
396188                           + sum(devices, input_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) + input_cap_alt_cost(devices) * input_capacity_MW(devices) * (1-active_devices(devices)) + output_cap_cost(devices) * output_capacity_MW(devices) * active_devices(devices))]$(ord(years)=1);
396189   
396190  debt_service_eqn..
396191  debt_service    =e= [debt_interest*(1-equity)*([sum(devices_ren, renew_cap_cost(devices_ren) * Renewable_MW(devices_ren))
396192                              + sum(devices, input_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) + input_cap_alt_cost(devices) * input_capacity_MW(devices) * (1-active_devices(devices)) + output_cap_cost(devices) * output_capacity_MW(devices) * active_devices(devices))]
396193                              + [sum(devices, H2stor_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) *( input_efficiency(devices) / H2_LHV )*storage_capacity_hours(devices))
396194                              + sum(devices, H2comp_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) *( input_efficiency(devices) / H2_LHV ))])]
396195                        /[1 - (1 + debt_interest)**(-NoYears)]  ;
396196   
396197  lin1(months,TOU_energy_period)$(0=1)..
396198                   electricity_surplus(months,TOU_energy_period) - sum(interval$(month_interval(months,interval) and elec_TOU_bins(TOU_energy_period,interval) and rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index),
396199                   interval_length*(sum(devices_ren,renewable_power_MW_sold(interval,devices_ren))+sum(devices,output_power_MW(interval,devices))-Import_elec_profile(interval)))
396200                   =g= -big_M*(1-esurplus_active(months,TOU_energy_period));
396201  lin2(months,TOU_energy_period)$(0=1)..
396202                   electricity_surplus(months,TOU_energy_period) - sum(interval$(month_interval(months,interval) and elec_TOU_bins(TOU_energy_period,interval) and rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index),
396203                   interval_length*(sum(devices_ren,renewable_power_MW_sold(interval,devices_ren))+sum(devices,output_power_MW(interval,devices))-Import_elec_profile(interval)))
396204                   =l= big_M*(1-esurplus_active(months,TOU_energy_period));
396205  lin3(months,TOU_energy_period)$(0=1)..
396206                   electricity_surplus(months,TOU_energy_period)  =l= big_M*esurplus_active(months,TOU_energy_period);
396207  lin4(months,TOU_energy_period)$(0=1)..
396208                   sum(interval$(month_interval(months,interval) and elec_TOU_bins(TOU_energy_period,interval) and rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index),interval_length*(sum(devices_ren,renewable_power_MW_sold(interval,devices_ren))+sum(devices,output_power_MW(interval,devices))-Import_elec_profile(interval)))
396209                   =g= -big_M*(1-esurplus_active(months,TOU_energy_period)) + small_M*esurplus_active(months,TOU_energy_period);
396210  lin5(months,TOU_energy_period)$(0=1)..
396211                   sum(interval$(month_interval(months,interval) and elec_TOU_bins(TOU_energy_period,interval) and rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index),interval_length*(sum(devices_ren,renewable_power_MW_sold(interval,devices_ren))+sum(devices,output_power_MW(interval,devices))-Import_elec_profile(interval)))
396212                   =l= big_M*esurplus_active(months,TOU_energy_period);
396213   
396214  * Max system power only includes electricity sold.
396215  system_power_eqn(interval)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
396216           sum(devices, output_power_MW_non_ren_sold(interval,devices) +
396217                        output_power_MW_ren_sold(interval,devices))
396218         + sum(devices_ren, renewable_power_MW_sold(interval,devices_ren)) =l= max_sys_output_cap;
396219   
396220  system_power_eqn2(interval)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
396221           Import_elec_profile(interval) =l= max_sys_input_cap;
396222   
396223  output_pwr_eqn2(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
396224           output_power_MW(interval,devices) =e= output_power_MW_non_ren_sold(interval,devices) + output_power_MW_non_ren_load(interval,devices) + output_power_MW_ren_sold(interval,devices) + output_power_MW_ren_load(interval,devices);
396225   
396226  output_LSL_eqn(interval,devices)$[( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )$output_LSL_fraction(devices)]..
396227           output_power_MW(interval,devices) - output_regdn_MW(interval,devices) =g= output_LSL_fraction(devices) * output_capacity_MW(devices) * output_active(interval,devices);
396228   
396229  output_capacity_limit_eqn(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index)..
396230           output_power_MW(interval,devices) + output_regup_MW(interval,devices) + output_spinres_MW(interval,devices) =l= Max_output_cap(interval,devices) * output_capacity_MW(devices) * output_active(interval,devices);
396231   
396232  output_regup_limit_eqn(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
396233           output_regup_MW(interval,devices) =l= Max_output_cap(interval,devices) * output_capacity_MW(devices) * output_regup_limit_fraction(devices);
396234   
396235  output_regdn_limit_eqn(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
396236           output_regdn_MW(interval,devices) =l= Max_output_cap(interval,devices) * output_capacity_MW(devices) * output_regdn_limit_fraction(devices);
396237   
396238  output_spinres_limit_eqn(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
396239           output_spinres_MW(interval,devices) =l= Max_output_cap(interval,devices) * output_capacity_MW(devices) * output_spinres_limit_fraction(devices);
396240   
396241  output_nonspinres_limit_eqn(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
396242           output_nonspinres_MW(interval,devices) =l= Max_output_cap(interval,devices) * output_capacity_MW(devices) * output_nonspinres_limit_fraction(devices) * ( 1 - output_active(interval,devices) );
396243   
396244  output_ramp_eqn(interval,devices)$[( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )$ramp_penalty]..
