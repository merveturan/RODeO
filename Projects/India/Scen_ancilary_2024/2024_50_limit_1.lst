395645  * Loads predictive controller values from excel file
395646  set scalar_option /so1/;
395647   
395648  Table controller_input_table (scalar_option,*)                   'Controller input values table'
395656  ;
395657  scalar current_interval2;
395658  scalar next_interval2  ;
395659  scalar current_storage_lvl2  ;
395660  scalar current_monthly_max2 ;
395661  scalar max_interval2  ;
395662   
395663  current_interval2=sum{scalar_option,controller_input_table(scalar_option,'current_interval')};
395664  next_interval2=sum{scalar_option,controller_input_table(scalar_option,'next_interval')};
395665  current_storage_lvl2=sum{scalar_option,controller_input_table(scalar_option,'current_storage_lvl')};
395666  current_monthly_max2=sum{scalar_option,controller_input_table(scalar_option,'current_monthly_max')};
395667  max_interval2=sum{scalar_option,controller_input_table(scalar_option,'max_interval')};
395668   
395669   
395670   
395671  if (read_MPC_file=1,
395672           current_interval    = current_interval2;
395673           next_interval       = next_interval2;
395674           current_storage_lvl = current_storage_lvl2;
395675           current_monthly_max = current_monthly_max2;
395676           max_interval        = max_interval2;
395677  );
