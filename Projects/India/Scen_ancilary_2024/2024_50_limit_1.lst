396367   
396368  input_capacity_limit_eqn2(interval)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
396369           Import_elec_profile(interval) =e= sum(devices,input_power_MW_non_ren(interval,devices) - output_power_MW_non_ren_load(interval,devices)) + Load_profile_non_ren(interval);
396370  *** Made a fixed value at the bottom instead of an equation
396371  ***input_capacity_limit_eqn3(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index and allow_import=0)..
396372  ***         Import_elec_profile(interval) =e= 0;
396373   
396374  input_ren_contribution(interval)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
396375           sum(devices,input_power_MW_ren(interval,devices)) + sum(devices_ren,renewable_power_MW_sold(interval,devices_ren)) + Load_profile_ren(interval) =l= sum(devices_ren,Renewable_power(interval,devices_ren));
396376   
396377  input_regup_limit_eqn(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
396378           input_regup_MW(interval,devices) =l= Max_input_cap(interval,devices) * input_capacity_MW(devices) * input_regup_limit_fraction(devices);
396379   
396380  input_regdn_limit_eqn(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
396381           input_regdn_MW(interval,devices) =l= Max_input_cap(interval,devices) * input_capacity_MW(devices) * input_regdn_limit_fraction(devices);
396382   
396383  input_spinres_limit_eqn(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
396384           input_spinres_MW(interval,devices) =l= Max_input_cap(interval,devices) * input_capacity_MW(devices) * input_spinres_limit_fraction(devices);
396385   
396386  input_nonspinres_limit_eqn(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
396387           input_nonspinres_MW(interval,devices) =l= Max_input_cap(interval,devices) * input_capacity_MW(devices) * input_nonspinres_limit_fraction(devices);
396388   
396389  load_profile_eqn(interval)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
396390           Load_profile(interval) =e= Load_profile_non_ren(interval) + Load_profile_ren(interval);
396391   
396392  storage_level_accounting_init_eqn(interval,devices)$(rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index and input_capacity_MW(devices) > 0 and baseload_operation(devices)=0 and ord(interval)=1)..
396393           storage_level_MWh(interval,devices)+storage_level_MWh_ren(interval,devices) =e= storage_init(devices)*storage_capacity_hours(devices)*input_capacity_MW(devices)
396394           + (input_power_MW_non_ren(interval,devices)+input_power_MW_ren(interval,devices)+input_power_MW_ren(interval,devices)) * interval_length * input_efficiency(devices)
396395           - (output_power_MW(interval,devices)+output_power_MW_ren_sold(interval,devices)+output_power_MW_ren_load(interval,devices)) * interval_length / output_efficiency(devices)
396396           - (H2_sold(interval,devices)+H2_sold_ren(interval,devices)) * H2_LHV;
396397  * LHV selected because fuel cell vehicles typically use a PEM FC and will release liquid water
396398   
396399  storage_level_accounting_final_eqn(interval,devices)$(rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index and input_capacity_MW(devices) > 0 and baseload_operation(devices)=0 and ord(interval)=operating_period_length and storage_set_final(devices)=1)..
396400           storage_level_MWh(interval,devices)+storage_level_MWh_ren(interval,devices) =e= storage_final(devices)*storage_capacity_hours(devices)*input_capacity_MW(devices);
396401  * LHV selected because fuel cell vehicles typically use a PEM FC and will release liquid water
396402   
396403  storage_level_accounting_eqn(interval,devices)$(rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index and input_capacity_MW(devices) > 0 and baseload_operation(devices)=0 and ord(interval)>current_interval and ord(interval)<max_interval and ord(interval)>1)..
396404           storage_level_MWh(interval,devices) =e= storage_level_MWh(interval-1,devices)
396405           +  input_power_MW_non_ren(interval,devices) * interval_length * input_efficiency(devices)
396406           - (output_power_MW_non_ren_sold(interval,devices) + output_power_MW_non_ren_load(interval,devices)) * interval_length / output_efficiency(devices)
396407           - H2_sold_non_ren(interval,devices) * H2_LHV;
396408  * LHV selected because fuel cell vehicles typically use a PEM FC and will release liquid water
396409   
396410  storage_level_accounting_eqn2(interval,devices)$(rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index and input_capacity_MW(devices) = 0 and baseload_operation(devices)=0 and ord(interval)>current_interval and ord(interval)<max_interval )..
396411           storage_level_MWh(interval,devices)+storage_level_MWh_ren(interval,devices) =e= storage_level_MWh(interval-1,devices)+storage_level_MWh_ren(interval-1,devices);
396412  * If input capacity is equal to zero then output device cannot interact with storage system so storage_level_MWh is held constant
396413   
396414  storage_level_accounting_eqn3(interval,devices)$(rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index and input_capacity_MW(devices) > 0 and ord(interval)>current_interval and ord(interval)<max_interval )..
396415           storage_level_MWh_ren(interval,devices) =e= storage_level_MWh_ren(interval-1,devices)
396416           + input_power_MW_ren(interval,devices) * interval_length * input_efficiency(devices)
396417           - (output_power_MW_ren_sold(interval,devices) + output_power_MW_ren_load(interval,devices)) * interval_length / output_efficiency(devices)
396418           - H2_sold_ren(interval,devices) * H2_LHV;
396419  * For H2_consumed, setting the last interval to output H2 can cause an infeasibiltiy when setting the init/final storage level (either 1. don't consume H2 in the last interval, 2. turn off storage setpoints or 3. sometimes I had to reduce the CF)
396420   
396421  H2_output_limit_eqn(days,devices)$(H2_sw and H2_use(devices) = 2)..
396422           H2_sold_daily(days,devices) =e= sum( interval$(floor(div(ord(interval)-1,24))+1 = ord(days) ), H2_sold(interval,devices) );
396423   
396424  H2_output_limit_eqn2(days,devices)$(H2_sw and H2_use(devices) = 2)..
396425           H2_sold_daily(days,devices) =e= sum( interval$(floor(div(ord(interval)-1,24))+1 = ord(days) ), H2_consumed(interval,devices) );
396426  * Reduce H2_sold for inactive devices
396427  H2_output_limit_eqn3(interval,devices)$( H2_sw and rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index and H2_use(devices) <= 1 and CF_opt=0)..
396428           H2_sold(interval,devices) =e= H2_consumed(interval,devices) * active_devices(devices) * (1 - CF_adjust(devices)*CF_adjust_value);
396429   
396430  H2_renewable_eqn(interval,devices)$(H2_sw and rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index and ord(interval)>current_interval and ord(interval)<max_interval )..
396431           H2_sold(interval,devices) =e= H2_sold_non_ren(interval,devices) + H2_sold_ren(interval,devices);
396432   
396433  storage_level_limit_eqn(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index and input_capacity_MW(devices)>0 and ord(interval)>current_interval and ord(interval)<max_interval )..
396434           storage_level_MWh(interval,devices) + storage_level_MWh_ren(interval,devices) =l= input_capacity_MW(devices) * storage_capacity_hours(devices)
396435           - input_regdn_MW(interval,devices) * interval_length * 0.5;
396436   
396437  storage_level_limit_eqn2(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index and input_capacity_MW(devices)<=0 and ord(interval)>current_interval and ord(interval)<max_interval )..
396438           storage_level_MWh(interval,devices) + storage_level_MWh_ren(interval,devices) =l= output_capacity_MW(devices) * storage_capacity_hours(devices)
396439           - input_regdn_MW(interval,devices) * interval_length * 0.5;
396440   
396441  storage_level_limit_eqn3(interval,devices)$(rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index and ord(interval)>current_interval and ord(interval)<max_interval )..
396442           storage_level_MWh(interval,devices) + storage_level_MWh_ren(interval,devices) =g= output_capacity_MW(devices) * storage_capacity_hours(devices) * (1-share_energy) * least_time_interval / input_efficiency(devices) ;
