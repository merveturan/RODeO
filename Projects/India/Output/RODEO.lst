53151   
53152           CF_opt "Select optimization criteria for system" /0/
53153           run_retail "Select to run retail or wholesale analysis (0=wholesale, 1=retail, 2=hybrid (retail for purchase and wholesale for sale))" /0/
53154           one_active_device "Enables equation to ensure that charge/discharge do not happen simultaneously" /1/
53155   
53156           min_output_on_intervals 'minimum number of intervals the output side of the facility can be on at a time' /0/
53157           min_input_on_intervals  'minimum number of intervals the input side of the facility can be on at a time' /0/
53158   
53159           current_interval        'current interval for real-time optimization runs'                              /-1/
53160           next_interval           'next interval for real-time optimization runs'                                 /1/
53161           current_storage_lvl     'current storage level for real-time optimization runs (0-100%, 0-1)'           /0.5/
53162           current_monthly_max     'current monthly maximum demand for real-time optimization runs (0-100%, 0-1)'  /0.8/
53163           max_interval            'maximum interval for real-time optimization runs'                              /Inf/
53164           read_MPC_file           'read controller values from excel file'                                        /0/
53165           ramp_penalty            'set ramp penalty for input and output devices'                                 /0/
53166           allow_import            'Allows or restricts imports 0=no imports, 1=allows imports'                    /1/
