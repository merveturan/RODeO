403940  *===============================================================================
403941  * DEPRECIATION SCHEDULES
403942  *===============================================================================
403943   
403944  parameter depreciation_schedule(years)  "Depreciation Schedule over year"
403945  /
403954  /;
403955   
403956  parameter  bonus_depreciation_schedule(years), NoYears;
403957  * For accelerated depreciation, bonus depreciation can vary from 50% to up to 100%. In future, it will go to 0%
403958  bonus_depreciation_schedule(years)$(ord(years)=1) = bonus_depreciation + (1-bonus_depreciation)*depreciation_schedule(years);
403959  bonus_depreciation_schedule(years)$(ord(years)>1) = (1-bonus_depreciation)*depreciation_schedule(years);
403960  * The basis for depreciation is directly calculated and is dependent of the Investment Tax Credit
403961  deprec_base_reduction = 1 - 0.5*ITC   ;
403962  * A scalar that takes the number of years considered in the optimization
403963  NoYears = card(years);
403964  * USA inflation vector is 1.9%
403965  inflation_vec(years) = (1 + 0.019)**(ord(years)-1);
403966  wacc =  (1 - equity)*(1 - debt_interest)*ror + equity*roe ;
403967  to_NPV(years) = (wacc + 1)**(ord(years)) ;
