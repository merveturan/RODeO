404402  ;
404403   
404404  * Adjusts the price of natural gas to the selected value "NG_price_adj"
404405  NG_price(interval) = NG_price(interval) * NG_price_adj;
404406   
404407  * Check to see if H2 will be exported for this analysis (i.e., H2 = 1 or 2)
404408  loop(devices,
404409      if (H2_use(devices) = 0,
404410           H2_consumed(interval,devices) = H2_consumed(interval,devices) * 0;
404411           H2_price(interval,devices)    = H2_price(interval,devices)*0;
404412      elseif H2_use(devices)=1,
404413           H2_price(interval,devices) = H2_price(interval,devices) * H2_price_adj(devices);
404414           if (CF_opt=0,
404415                   H2_consumed(interval,devices) = H2_consumed(interval,devices) * H2_consumed_adj(devices) * input_capacity_MW(devices) * input_efficiency(devices) / H2_LHV * 24 * interval_length;
404416           elseif CF_opt=1,
404417                   H2_consumed_adj(devices) = input_capacity_MW(devices) * input_efficiency(devices) / H2_LHV *24;
404418           );
404419      elseif H2_use(devices)=2,
404420      );
404421  );
404422   
404423  H2_CF_eqn(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index and CF_opt=1)..
404424           H2_sold(interval,devices) =e= H2_consumed(interval,devices) * H2_consumed_adj(devices) * Hydrogen_fraction;
404425   
404426  H2_CF_eqn2$(CF_opt=1).. Hydrogen_fraction =l= 1;
404427  H2_CF_eqn3$(CF_opt=0).. Hydrogen_fraction =e= 1;
404428   
404429   
404430  *** Cost function: Elec sale price, elec purchase price, regup, regdown, spin, nonspin, NGout/in, unused VOM cost, startup cost, H2 price, VOM cost, demand charge (fixed and timed), meter cost, cap and FOM cost, etc.
404431   
404432  operating_profit_eqn..
404433   
404434                operating_profit =e=
404435   
404436                   - sum(devices_ren, equity * renew_cap_cost(devices_ren) * Renewable_MW(devices_ren))
404437                   - sum(devices, equity * input_cap_cost(devices)  * input_capacity_MW(devices) * active_devices(devices))
404438                   - sum(devices, equity * output_cap_cost(devices) * output_capacity_MW(devices) * active_devices(devices))
404439                   - sum(devices, equity * H2stor_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) * ( input_efficiency(devices) / H2_LHV )*storage_capacity_hours(devices))
404440                   - sum(devices, equity * H2comp_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) * ( input_efficiency(devices) / H2_LHV ))
404441                   - sum(devices, equity * input_cap_alt_cost(devices) * input_capacity_MW(devices) * (1-active_devices(devices)))
404442                   + sum(years,[yearly_taxes(years)
404443                   - debt_service
404444                   + inflation_vec(years)*yearly_operating_profit]/to_NPV(years))
404445                   - sum((interval,devices),100 * cooldown(interval,devices))
404446  ;
404447   
404448  depreciation(years)..
404449  amount_depreciated(years) =e= deprec_base_reduction*bonus_depreciation_schedule(years)*[sum(devices_ren, renew_cap_cost(devices_ren) * Renewable_MW(devices_ren))
404450                              + sum(devices, input_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) + input_cap_alt_cost(devices) * input_capacity_MW(devices) * (1-active_devices(devices)) + output_cap_cost(devices) * output_capacity_MW(devices) * active_devices(devices))]
404451                              + depreciation_schedule(years)*[sum(devices, H2stor_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) *( input_efficiency(devices) / H2_LHV )*storage_capacity_hours(devices))
404452                              + sum(devices, H2comp_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) *( input_efficiency(devices) / H2_LHV ))];
404453   
404454  yearly_operating_profit_eqn..
404455           yearly_operating_profit =e=
404456                  sum( (interval)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index ),
404457                          yearly_operating_profit_interval(interval))
404458                   - sum(months, Fixed_cap(months) * Fixed_dem(months))
404459                   - sum(months, cap_1(months) * Timed_dem("1"))
404460                   - sum(months, cap_2(months) * Timed_dem("2"))
404461                   - sum(months, cap_3(months) * Timed_dem("3"))
404462                   - sum(months, cap_4(months) * Timed_dem("4"))
404463                   - sum(months, cap_5(months) * Timed_dem("5"))
404464                   - sum(months, cap_6(months) * Timed_dem("6"))
404465                   - meter_mnth_chg("1") * 12
404466                   - sum(devices_ren,renew_FOM_cost(devices_ren) * Renewable_MW(devices_ren))
404467                   - sum(devices,input_FOM_cost(devices) * input_capacity_MW(devices) * active_devices(devices))
404468                   - sum(devices,input_FOM_alt_cost(devices) * input_capacity_MW(devices) * (1-active_devices(devices)))
404469                   - sum(devices,output_FOM_cost(devices)* output_capacity_MW(devices) * active_devices(devices))
404470                   + sum((months,TOU_energy_period),(NSCR(months)-TOU_energy_prices(TOU_energy_period)-NBC)*electricity_surplus(months,TOU_energy_period))*(0)
404471                   + sum((months,TOU_energy_period),(TOU_energy_prices(TOU_energy_period))*[sum(interval$(month_interval(months,interval) and elec_TOU_bins(TOU_energy_period,interval) and rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index),
404472                     interval_length*(sum(devices_ren,renewable_power_MW_sold(interval,devices_ren))+sum(devices,output_power_MW(interval,devices))-Import_elec_profile(interval)))])*(0)
404473                   - sum(devices, CF_adjust(devices))*CF_penalty
404474                   ;
404475   
404476  yearly_operating_profit_interval_eqn(interval)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
404477           yearly_operating_profit_interval(interval) =e=
404478                  (elec_sale_price_forecast(interval)*(sum(devices,output_power_MW_ren_sold(interval,devices)+output_power_MW_non_ren_sold(interval,devices))
404479                  +sum(devices_ren,renewable_power_MW_sold(interval,devices_ren))) * interval_length)*(1-0)
404480                   + REC_price * (sum(devices_ren,renewable_power_MW_sold(interval,devices_ren)) + sum(devices,output_power_MW_ren_sold(interval,devices))) * interval_length
404481                   - (elec_purchase_price_forecast(interval) * Import_elec_profile(interval) * interval_length)*(1-0)
404482                   + ( regup_price(interval) - reg_cost ) * ( sum(devices,output_regup_MW(interval,devices) + input_regup_MW(interval,devices)) ) * interval_length
404483                   + ( regdn_price(interval) - reg_cost ) * ( sum(devices,output_regdn_MW(interval,devices) + input_regdn_MW(interval,devices)) ) * interval_length
404484                   + spinres_price(interval) * ( sum(devices,output_spinres_MW(interval,devices) + input_spinres_MW(interval,devices)) ) * interval_length
404485                   + nonspinres_price(interval) * ( sum(devices,output_nonspinres_MW(interval,devices) + input_nonspinres_MW(interval,devices)) ) * interval_length
404486                   - sum(devices,output_heat_rate(devices) * NG_price(interval) * output_power_MW(interval,devices)) * interval_length
404487                   - sum(devices,input_heat_rate(devices) * NG_price(interval) * input_power_MW(interval,devices)) * interval_length
404488                   - VOM_cost * sum(devices,output_power_MW(interval,devices)) * interval_length
404489                   - sum(devices,output_startup_cost(devices) * output_capacity_MW(devices) * output_start(interval,devices))
404490                   - sum(devices,input_startup_cost(devices) * input_capacity_MW(devices) * input_start(interval,devices))
404491                   + sum(devices,H2_price(interval,devices) * H2_sold(interval,devices))
404492                   + sum(devices,(CI_base_line*EER - Grid_CarbInt/input_efficiency(devices))*LCFS_price*H2_EneDens*(power(10,-6)) * H2_sold(interval,devices))
404493                   + sum(devices,Grid_CarbInt*LCFS_price*H2_EneDens*(power(10,-6)) * H2_sold_ren(interval,devices))
404494                   - sum(devices_ren,renew_VOM_cost(devices_ren) * Renewable_power(interval,devices_ren))* interval_length
404495                   - sum(devices,input_VOM_cost(devices) * input_power_MW(interval,devices)) * interval_length
404496                   - sum(devices,output_VOM_cost(devices)* output_power_MW(interval,devices))* interval_length
404497                   - sum(devices,(input_ramp_pos(interval,devices)+input_ramp_neg(interval,devices))*ramp_penalty)
404498                   - sum(devices,(output_ramp_pos(interval,devices)+output_ramp_neg(interval,devices))*ramp_penalty)
404499                   + sum(devices, storage_level_MWh(interval,devices)) * Storage_penalty * (1-1)
404500  ;
404501   
404502  * Taxes include an ITC offset for renewables, input devices and output devices (change as necessary for specific technologies).
404503  taxes_lin1(years)..
404504                    - cftr*(yearly_operating_profit*inflation_vec(years) - amount_depreciated(years))
404505                    + reserved_taxes(years-1)
404506                    + ITC*deprec_base_reduction*[sum(devices_ren, renew_cap_cost(devices_ren) * Renewable_MW(devices_ren))
404507                    + sum(devices, input_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) + input_cap_alt_cost(devices) * input_capacity_MW(devices) * (1-active_devices(devices)) + output_cap_cost(devices) * output_capacity_MW(devices) * active_devices(devices))]$(ord(years)=1)
404508                    =l= big_Mtaxes*(1 - taxes_active(years)) ;
404509   
404510  taxes_lin2(years)..
404511                    - cftr*(yearly_operating_profit*inflation_vec(years) - amount_depreciated(years))
404512                    + reserved_taxes(years-1)
404513                    + ITC*deprec_base_reduction*[sum(devices_ren, renew_cap_cost(devices_ren) * Renewable_MW(devices_ren))
404514                    + sum(devices, input_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) + input_cap_alt_cost(devices) * input_capacity_MW(devices) * (1-active_devices(devices)) + output_cap_cost(devices) * output_capacity_MW(devices) * active_devices(devices))]$(ord(years)=1)
404515                    =g= -big_Mtaxes*taxes_active(years) ;
404516   
404517  taxes_lin3(years)..
404518                   yearly_taxes(years) - [- cftr*(yearly_operating_profit*inflation_vec(years) - amount_depreciated(years))
404519                    + reserved_taxes(years-1)
404520                    + ITC*deprec_base_reduction*[sum(devices_ren, renew_cap_cost(devices_ren) * Renewable_MW(devices_ren))
404521                    + sum(devices, input_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) + input_cap_alt_cost(devices) * input_capacity_MW(devices) * (1-active_devices(devices)) + output_cap_cost(devices) * output_capacity_MW(devices) * active_devices(devices))]$(ord(years)=1)]
404522                   =l= big_Mtaxes*(1 - taxes_active(years)) ;
404523   
404524  taxes_lin4(years)..
404525                   yearly_taxes(years) - [- cftr*(yearly_operating_profit*inflation_vec(years) - amount_depreciated(years))
404526                    + reserved_taxes(years-1)
404527                    + ITC*deprec_base_reduction*[sum(devices_ren, renew_cap_cost(devices_ren) * Renewable_MW(devices_ren))
404528                    + sum(devices, input_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) + input_cap_alt_cost(devices) * input_capacity_MW(devices) * (1-active_devices(devices)) + output_cap_cost(devices) * output_capacity_MW(devices) * active_devices(devices))]$(ord(years)=1)]
404529                   =g= -big_Mtaxes*(1 - taxes_active(years)) ;
404530   
404531  taxes_lin5(years)..
404532                   yearly_taxes(years) =g= - big_Mtaxes*taxes_active(years) ;
404533   
404534   
404535  reserved_taxes_eqn(years)..
404536  reserved_taxes(years)  =e= reserved_taxes(years-1) - yearly_taxes(years) - cftr*(yearly_operating_profit*inflation_vec(years) - amount_depreciated(years))
404537                           + ITC*deprec_base_reduction*[sum(devices_ren, renew_cap_cost(devices_ren) * Renewable_MW(devices_ren))
404538                           + sum(devices, input_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) + input_cap_alt_cost(devices) * input_capacity_MW(devices) * (1-active_devices(devices)) + output_cap_cost(devices) * output_capacity_MW(devices) * active_devices(devices))]$(ord(years)=1);
404539   
404540  debt_service_eqn..
404541  debt_service    =e= [debt_interest*(1-equity)*([sum(devices_ren, renew_cap_cost(devices_ren) * Renewable_MW(devices_ren))
404542                              + sum(devices, input_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) + input_cap_alt_cost(devices) * input_capacity_MW(devices) * (1-active_devices(devices)) + output_cap_cost(devices) * output_capacity_MW(devices) * active_devices(devices))]
404543                              + [sum(devices, H2stor_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) *( input_efficiency(devices) / H2_LHV )*storage_capacity_hours(devices))
404544                              + sum(devices, H2comp_cap_cost(devices) * input_capacity_MW(devices) * active_devices(devices) *( input_efficiency(devices) / H2_LHV ))])]
404545                        /[1 - (1 + debt_interest)**(-NoYears)]  ;
404546   
404547  lin1(months,TOU_energy_period)$(0=1)..
404548                   electricity_surplus(months,TOU_energy_period) - sum(interval$(month_interval(months,interval) and elec_TOU_bins(TOU_energy_period,interval) and rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index),
404549                   interval_length*(sum(devices_ren,renewable_power_MW_sold(interval,devices_ren))+sum(devices,output_power_MW(interval,devices))-Import_elec_profile(interval)))
404550                   =g= -big_M*(1-esurplus_active(months,TOU_energy_period));
404551  lin2(months,TOU_energy_period)$(0=1)..
404552                   electricity_surplus(months,TOU_energy_period) - sum(interval$(month_interval(months,interval) and elec_TOU_bins(TOU_energy_period,interval) and rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index),
404553                   interval_length*(sum(devices_ren,renewable_power_MW_sold(interval,devices_ren))+sum(devices,output_power_MW(interval,devices))-Import_elec_profile(interval)))
404554                   =l= big_M*(1-esurplus_active(months,TOU_energy_period));
404555  lin3(months,TOU_energy_period)$(0=1)..
404556                   electricity_surplus(months,TOU_energy_period)  =l= big_M*esurplus_active(months,TOU_energy_period);
404557  lin4(months,TOU_energy_period)$(0=1)..
404558                   sum(interval$(month_interval(months,interval) and elec_TOU_bins(TOU_energy_period,interval) and rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index),interval_length*(sum(devices_ren,renewable_power_MW_sold(interval,devices_ren))+sum(devices,output_power_MW(interval,devices))-Import_elec_profile(interval)))
404559                   =g= -big_M*(1-esurplus_active(months,TOU_energy_period)) + small_M*esurplus_active(months,TOU_energy_period);
404560  lin5(months,TOU_energy_period)$(0=1)..
404561                   sum(interval$(month_interval(months,interval) and elec_TOU_bins(TOU_energy_period,interval) and rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index),interval_length*(sum(devices_ren,renewable_power_MW_sold(interval,devices_ren))+sum(devices,output_power_MW(interval,devices))-Import_elec_profile(interval)))
404562                   =l= big_M*esurplus_active(months,TOU_energy_period);
404563   
404564  * Max system power only includes electricity sold.
404565  system_power_eqn(interval)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
404566           sum(devices, output_power_MW_non_ren_sold(interval,devices) +
404567                        output_power_MW_ren_sold(interval,devices))
404568         + sum(devices_ren, renewable_power_MW_sold(interval,devices_ren)) =l= max_sys_output_cap;
404569   
404570  system_power_eqn2(interval)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
404571           Import_elec_profile(interval) =l= max_sys_input_cap;
404572   
404573  output_pwr_eqn2(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
404574           output_power_MW(interval,devices) =e= output_power_MW_non_ren_sold(interval,devices) + output_power_MW_non_ren_load(interval,devices) + output_power_MW_ren_sold(interval,devices) + output_power_MW_ren_load(interval,devices);
404575   
404576  output_LSL_eqn(interval,devices)$[( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )$output_LSL_fraction(devices)]..
404577           output_power_MW(interval,devices) - output_regdn_MW(interval,devices) =g= output_LSL_fraction(devices) * output_capacity_MW(devices) * output_active(interval,devices);
404578   
404579  output_capacity_limit_eqn(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index)..
404580           output_power_MW(interval,devices) + output_regup_MW(interval,devices) + output_spinres_MW(interval,devices) =l= Max_output_cap(interval,devices) * output_capacity_MW(devices) * output_active(interval,devices);
404581   
404582  output_regup_limit_eqn(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
404583           output_regup_MW(interval,devices) =l= Max_output_cap(interval,devices) * output_capacity_MW(devices) * output_regup_limit_fraction(devices);
404584   
404585  output_regdn_limit_eqn(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
404586           output_regdn_MW(interval,devices) =l= Max_output_cap(interval,devices) * output_capacity_MW(devices) * output_regdn_limit_fraction(devices);
404587   
404588  output_spinres_limit_eqn(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
404589           output_spinres_MW(interval,devices) =l= Max_output_cap(interval,devices) * output_capacity_MW(devices) * output_spinres_limit_fraction(devices);
404590   
404591  output_nonspinres_limit_eqn(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
404592           output_nonspinres_MW(interval,devices) =l= Max_output_cap(interval,devices) * output_capacity_MW(devices) * output_nonspinres_limit_fraction(devices) * ( 1 - output_active(interval,devices) );
404593   
404594  output_ramp_eqn(interval,devices)$[( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )$ramp_penalty]..
404595           output_power_MW(interval,devices)-output_power_MW(interval-1,devices) =e= output_ramp_pos(interval,devices)-output_ramp_neg(interval,devices);
404596   
404597  input_ramp_eqn(interval,devices)$[( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )$ramp_penalty]..
404598           input_power_MW(interval,devices)-input_power_MW(interval-1,devices) =e= input_ramp_pos(interval,devices)-input_ramp_neg(interval,devices);
404599   
404600  input_pwr_eqn(interval,devices)$(baseload_operation(devices) = 1 )..
404601           input_power_MW(interval,devices) =e= Max_input_cap(interval,devices) * input_capacity_MW(devices) * H2_consumed_adj(devices);
404602   
404603  input_pwr_eqn2(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
404604           input_power_MW(interval,devices) =e= input_power_MW_non_ren(interval,devices) + input_power_MW_ren(interval,devices);
404605   
404606  input_LSL_eqn(interval,devices)$[( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )$input_LSL_fraction(devices)]..
404607           input_power_MW(interval,devices) - input_regup_MW(interval,devices) - input_spinres_MW(interval,devices) - input_nonspinres_MW(interval,devices) =g= input_LSL_fraction(devices) * input_capacity_MW(devices) * input_active(interval,devices);
404608   
404609  input_capacity_limit_eqn(interval,devices)$( rolling_window_min_index <= ord(interval) and ord(interval) <= rolling_window_max_index )..
404610           input_power_MW(interval,devices) + input_regdn_MW(interval,devices) =l= Max_input_cap(interval,devices) * input_capacity_MW(devices) * input_active(interval,devices);
404611   
